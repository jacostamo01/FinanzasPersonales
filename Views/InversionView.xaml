<Window x:Class="FinanzasPersonales.NET.Views.InversionView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Finanzas Personales - Inversiones"
        Height="750"
        Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="24">
        <StackPanel>

            <TextBlock Text="INVERSIONES"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8" />

            <TextBlock Text="Gestión de inversiones"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20" />

            <!-- Formulario crear -->
            <TextBlock Text="Descripción:" />
            <TextBox x:Name="txtDescripcion"
                     Height="32"
                     Margin="0,6,0,14" />

            <TextBlock Text="Monto inicial:" />
            <TextBox x:Name="txtMonto"
                     Height="32"
                     Margin="0,6,0,14" />

            <TextBlock Text="Tasa de interés anual (ej: 0.05 para 5%):" />
            <TextBox x:Name="txtTasa"
                     Height="32"
                     Margin="0,6,0,20" />

            <Button Content="Crear Inversión"
                    Height="36"
                    Margin="0,0,0,10"
                    Click="BtnCrearInversion_Click" />

            <!-- Actualizar -->
            <TextBlock Text="ID de inversión a actualizar:" />
            <TextBox x:Name="txtInversionId"
                     Height="32"
                     Margin="0,6,0,14" />

            <TextBlock Text="Nuevo monto:" />
            <TextBox x:Name="txtNuevoMonto"
                     Height="32"
                     Margin="0,6,0,14" />

            <Button Content="Actualizar Inversión"
                    Height="36"
                    Margin="0,0,0,10"
                    Click="BtnActualizar_Click" />

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="Ver Inversiones"
                        Height="36"
                        Click="BtnVerInversiones_Click" />
                <Button Grid.Column="2"
                        Content="Ver Resumen"
                        Height="36"
                        Click="BtnVerResumen_Click" />
            </Grid>

            <Button Content="Volver al Menú Principal"
                    Height="36"
                    Margin="0,0,0,10"
                    Click="BtnVolver_Click" />

            <TextBlock x:Name="txtMensaje"
                       Text=""
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,12,0,0" />

        </StackPanel>
    </Grid>
</Window>