<Window x:Class="FinanzasPersonales.NET.Views.EstadisticaView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Finanzas Personales - Estadísticas"
        Height="650"
        Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="24">
        <StackPanel>

            <TextBlock Text="ESTADÍSTICAS FINANCIERAS"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8" />

            <TextBlock Text="Resumen de tu situación financiera"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,24" />

            <Button Content="Ver Resumen General"
                    Height="36"
                    Margin="0,0,0,10"
                    Click="BtnResumenGeneral_Click" />

            <Button Content="Ver Gastos por Categoría"
                    Height="36"
                    Margin="0,0,0,10"
                    Click="BtnGastosPorCategoria_Click" />

            <Button Content="Ver Resumen Mensual"
                    Height="36"
                    Margin="0,0,0,10"
                    Click="BtnResumenMensual_Click" />

            <Button Content="Ver Todo"
                    Height="36"
                    Margin="0,0,0,10"
                    Click="BtnVerTodo_Click" />

            <Button Content="Ver Gráficas Visuales"
                    Height="36"
                    Margin="0,0,0,20"
                    Background="#2088ff"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Click="BtnVerGraficas_Click" />

            <!-- Nueva sección de correo -->
            <TextBlock Text="Enviar resumen a:"
                       FontSize="14"
                       Margin="0,0,0,5" />
            <TextBox x:Name="txtCorreoDestino"
                     Height="30"
                     Margin="0,0,0,10"
                     VerticalContentAlignment="Center"
                     Padding="5,0" />
            <Button Content="Enviar por Correo Electrónico"
                    Height="36"
                    Margin="0,0,0,10"
                    Click="BtnEnviarCorreo_Click" />

            <Button Content="Volver al Menú Principal"
                    Height="36"
                    Margin="0,10,0,0"
                    Click="BtnVolver_Click" />

            <TextBlock x:Name="txtMensaje"
                       Text=""
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,18,0,0" />

        </StackPanel>
    </Grid>
</Window>