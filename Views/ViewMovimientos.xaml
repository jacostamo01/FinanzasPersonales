<Window x:Class="FinanzasPersonales.NET.Views.ViewMovimientos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Finanzas Personales - Movimientos"
        Height="580"
        Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="24">
        <StackPanel>

            <TextBlock Text="MOVIMIENTOS"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8" />

            <TextBlock Text="Ingresos y Gastos"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20" />

            <!-- Formulario -->
            <TextBlock Text="Monto:" />
            <TextBox x:Name="txtMonto"
                     Height="32"
                     Margin="0,6,0,14" />

            <TextBlock Text="Descripción:" />
            <TextBox x:Name="txtDescripcion"
                     Height="32"
                     Margin="0,6,0,14" />

            <TextBlock Text="Categoría (solo para gastos):" />
            <TextBox x:Name="txtCategoria"
                     Height="32"
                     Margin="0,6,0,20" />

            <!-- Botones agregar -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="Agregar Ingreso"
                        Height="36"
                        Click="BtnAgregarIngreso_Click" />
                <Button Grid.Column="2"
                        Content="Agregar Gasto"
                        Height="36"
                        Click="BtnAgregarGasto_Click" />
            </Grid>

            <!-- Botones ver -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="Ver Todos"
                        Height="36"
                        Click="BtnVerTodos_Click" />
                <Button Grid.Column="2"
                        Content="Ver Ingresos"
                        Height="36"
                        Click="BtnVerIngresos_Click" />
                <Button Grid.Column="4"
                        Content="Ver Gastos"
                        Height="36"
                        Click="BtnVerGastos_Click" />
            </Grid>

            <Button Content="Ver Resumen"
                    Height="36"
                    Margin="0,0,0,10"
                    Click="BtnVerResumen_Click" />

            <Button Content="Volver al Menú Principal"
                    Height="36"
                    Margin="0,0,0,10"
                    Click="BtnVolver_Click" />

            <TextBlock x:Name="txtMensaje"
                       Text=""
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,12,0,0" />

        </StackPanel>
    </Grid>
</Window>