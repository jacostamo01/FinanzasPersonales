<Window x:Class="FinanzasPersonales.NET.Views.ViewMovimientos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Finanzas Personales - Movimientos"
        Height="780"
        MinHeight="600"
        Width="680"
        MinWidth="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── Fila 0: Formulario y botones ── -->
        <StackPanel Grid.Row="0">

            <TextBlock Text="MOVIMIENTOS"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8" />

            <TextBlock Text="Ingresos y Gastos"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,16" />

            <!-- Formulario -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Monto:" />
                    <TextBox x:Name="txtMonto" Height="32" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Descripción:" />
                    <TextBox x:Name="txtDescripcion" Height="32" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="Categoría (solo gastos):" />
                    <ComboBox x:Name="cmbCategoria"
                              Height="32"
                              Margin="0,4,0,0"
                              IsEnabled="False"
                              ToolTip="Selecciona una categoría para el gasto" />
                </StackPanel>
            </Grid>

            <!-- Botones agregar -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="➕ Agregar Ingreso" Height="34" Click="BtnAgregarIngreso_Click" />
                <Button Grid.Column="2" Content="➕ Agregar Gasto"   Height="34" Click="BtnAgregarGasto_Click" />
            </Grid>

            <!-- Botones ver -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="📋 Todos"    Height="32" Click="BtnVerTodos_Click" />
                <Button Grid.Column="2" Content="📈 Ingresos" Height="32" Click="BtnVerIngresos_Click" />
                <Button Grid.Column="4" Content="📉 Gastos"   Height="32" Click="BtnVerGastos_Click" />
                <Button Grid.Column="6" Content="📊 Resumen"  Height="32" Click="BtnVerResumen_Click" />
            </Grid>

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="txtMensaje"
                           Grid.Column="0"
                           Text=""
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <Button Grid.Column="2"
                        Content="← Volver"
                        Height="32"
                        Width="100"
                        Click="BtnVolver_Click" />
            </Grid>

        </StackPanel>

        <!-- ── Fila 1: Tabla de datos ── -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="txtTablaTitulo"
                       Grid.Row="0"
                       Text=""
                       FontWeight="Bold"
                       FontSize="13"
                       Margin="0,0,0,6" />

            <DataGrid x:Name="dgDatos"
                      Grid.Row="1"
                      AutoGenerateColumns="True"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      GridLinesVisibility="All"
                      AlternatingRowBackground="#F0F4FF"
                      RowBackground="White"
                      BorderBrush="#CCCCCC"
                      BorderThickness="1"
                      ColumnHeaderHeight="32"
                      RowHeight="28"
                      SelectionMode="Single"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto" />
        </Grid>

    </Grid>
</Window>