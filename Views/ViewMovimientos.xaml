<Window x:Class="FinanzasPersonales.NET.Views.ViewMovimientos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Finanzas Personales - Movimientos"
        Height="780"
        Width="700"
        MinHeight="620"
        MinWidth="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">

            <TextBlock Text="MOVIMIENTOS"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8" />

            <TextBlock Text="Ingresos y Gastos"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,16" />

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Monto:" />
                    <TextBox x:Name="txtMonto"
                             Height="32"
                             Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Descripción:" />
                    <TextBox x:Name="txtDescripcion"
                             Height="32"
                             Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <CheckBox x:Name="chkUsarCategoria"
                      Content="Asignar categoría al gasto"
                      Margin="0,0,0,6"
                      Checked="ChkUsarCategoria_Checked"
                      Unchecked="ChkUsarCategoria_Unchecked" />

            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Categoría (solo para gastos):" />
                <ComboBox x:Name="cmbCategoria"
                          Height="32"
                          Margin="0,4,0,0"
                          IsEnabled="False"
                          ToolTip="Selecciona una categoría para el gasto" />
            </StackPanel>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="btnAgregarIngreso"
                        Grid.Column="0"
                        Content="Agregar Ingreso"
                        Height="36"
                        Click="BtnAgregarIngreso_Click" />
                <Button x:Name="btnAgregarGasto"
                        Grid.Column="2"
                        Content="Agregar Gasto"
                        Height="36"
                        Click="BtnAgregarGasto_Click" />
            </Grid>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="Ver Todos"
                        Height="36"
                        Click="BtnVerTodos_Click" />
                <Button Grid.Column="2"
                        Content="Ver Ingresos"
                        Height="36"
                        Click="BtnVerIngresos_Click" />
                <Button Grid.Column="4"
                        Content="Ver Gastos"
                        Height="36"
                        Click="BtnVerGastos_Click" />
                <Button Grid.Column="6"
                        Content="Ver Resumen"
                        Height="36"
                        Click="BtnVerResumen_Click" />
            </Grid>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="txtMensaje"
                           Grid.Column="0"
                           Text=""
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />

                <Button Grid.Column="2"
                        Content="Volver al Menú Principal"
                        Height="36"
                        Padding="14,0"
                        Click="BtnVolver_Click" />
            </Grid>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="txtTablaTitulo"
                       FontWeight="Bold"
                       FontSize="13"
                       Margin="0,0,0,6" />

            <DataGrid x:Name="dgDatos"
                      Grid.Row="1"
                      AutoGenerateColumns="True"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      GridLinesVisibility="All"
                      AlternatingRowBackground="#F4F7FB"
                      RowBackground="White"
                      BorderBrush="#D0D7DE"
                      BorderThickness="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto" />
        </Grid>
    </Grid>
</Window>
