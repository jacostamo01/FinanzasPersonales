<Window x:Class="FinanzasPersonales.NET.Views.ViewLogin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Finanzas Personales - Login"
        Height="430"
        Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="24">
        <StackPanel VerticalAlignment="Center">

            <TextBlock Text="FINANZAS PERSONALES"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8" />

            <TextBlock Text="Inicio de sesión y registro"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,24" />

            <TextBlock Text="Usuario" />
            <TextBox x:Name="txtUsuario"
                     Height="32"
                     Margin="0,6,0,14" />

            <TextBlock Text="Contraseña" />
            <PasswordBox x:Name="txtPassword"
                         Height="32"
                         Margin="0,6,0,14" />

            <TextBlock Text="Confirmar contraseña (solo para registrarse)" />
            <PasswordBox x:Name="txtConfirmarPassword"
                         Height="32"
                         Margin="0,6,0,20" />

            <Button Content="Iniciar sesión"
                    Height="36"
                    Margin="0,0,0,10"
                    Click="BtnLogin_Click" />

            <Button Content="Registrarse"
                    Height="36"
                    Click="BtnRegistrar_Click" />

            <TextBlock x:Name="txtMensaje"
                       Text=""
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,18,0,0" />
        </StackPanel>
    </Grid>
</Window>
