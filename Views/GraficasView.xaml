<Window x:Class="FinanzasPersonales.NET.Views.GraficasView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="Gráficas Visuales" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="DASHBOARD DE ESTADÍSTICAS"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Gráfico de Pastel: Gastos por Categoría -->
            <StackPanel Grid.Column="0" Margin="10">
                <TextBlock Text="Gastos por Categoría" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <lvc:PieChart Series="{Binding SeriesPastel}" 
                              Height="400" 
                              LegendPosition="Right"/>
            </StackPanel>

            <!-- Gráfico de Barras: Histórico de Ingresos y Gastos -->
            <StackPanel Grid.Column="1" Margin="10">
                <TextBlock Text="Ingresos vs Gastos (Últimos 6 Meses)" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <lvc:CartesianChart Series="{Binding SeriesBarras}" 
                                    XAxes="{Binding EjesXBarras}"
                                    Height="400" 
                                    LegendPosition="Top"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
