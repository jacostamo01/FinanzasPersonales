<Window x:Class="FinanzasPersonales.NET.Views.AhorroView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Finanzas Personales - Ahorros"
        Height="800"
        MinHeight="600"
        Width="720"
        MinWidth="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── Fila 0: Formulario y botones ── -->
        <StackPanel Grid.Row="0">

            <TextBlock Text="AHORROS"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8" />

            <TextBlock Text="Metas de ahorro"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,14" />

            <!-- Formulario crear meta -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Descripción:" />
                    <TextBox x:Name="txtDescripcion" Height="32" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Monto objetivo:" />
                    <TextBox x:Name="txtMonto" Height="32" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="Fecha objetivo (dd/MM/yyyy):" />
                    <TextBox x:Name="txtFecha" Height="32" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <Button Content="➕ Crear Meta de Ahorro"
                    Height="34"
                    Margin="0,0,0,10"
                    Click="BtnCrearMeta_Click" />

            <!-- Depositar / Retirar -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="ID de meta:" />
                    <TextBox x:Name="txtAhorroId" Height="32" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Monto a depositar/retirar:" />
                    <TextBox x:Name="txtMontoAccion" Height="32" Margin="0,4,0,0" />
                </StackPanel>

                <Button Grid.Column="4"
                        Content="💰 Depositar"
                        Height="32"
                        Width="110"
                        VerticalAlignment="Bottom"
                        Click="BtnDepositar_Click" />

                <Button Grid.Column="6"
                        Content="💸 Retirar"
                        Height="32"
                        Width="110"
                        VerticalAlignment="Bottom"
                        Click="BtnRetirar_Click" />
            </Grid>

            <!-- Botones ver -->
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="📋 Ver Metas"   Height="32" Click="BtnVerMetas_Click" />
                <Button Grid.Column="2" Content="📊 Ver Resumen" Height="32" Click="BtnVerResumen_Click" />
                <Button Grid.Column="4" Content="← Volver" Height="32" Width="100" Click="BtnVolver_Click" />
            </Grid>

            <TextBlock x:Name="txtMensaje"
                       Text=""
                       TextWrapping="Wrap"
                       Margin="0,4,0,0" />

        </StackPanel>

        <!-- ── Fila 1: Tabla de datos ── -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="txtTablaTitulo"
                       Grid.Row="0"
                       Text=""
                       FontWeight="Bold"
                       FontSize="13"
                       Margin="0,0,0,6" />

            <DataGrid x:Name="dgDatos"
                      Grid.Row="1"
                      AutoGenerateColumns="True"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      GridLinesVisibility="All"
                      AlternatingRowBackground="#F0F4FF"
                      RowBackground="White"
                      BorderBrush="#CCCCCC"
                      BorderThickness="1"
                      ColumnHeaderHeight="32"
                      RowHeight="28"
                      SelectionMode="Single"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto" />
        </Grid>

    </Grid>
</Window>