<Window x:Class="FinanzasPersonales.NET.Views.ColchonFinancieroView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Colchon Financiero"
        Height="760"
        Width="1120"
        MinHeight="680"
        MinWidth="980"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F4F6F8">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Colchon Financiero"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#1F2937"
                   Margin="0,0,0,20"/>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,16">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#F8FAFC"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Crear colchón financiero"
                                       FontWeight="Bold"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="Monto meta del colchón"/>
                            <TextBox x:Name="TxtMeta"
                                     Height="35"
                                     Margin="0,5,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="2"
                                Content="Crear"
                                Width="100"
                                Height="35"
                                VerticalAlignment="Bottom"
                                Click="BtnCrear_Click"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Background="#F8FAFC"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Mover dinero del colchón"
                                       FontWeight="Bold"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="Monto de la operación (depositar o retirar)"/>
                            <TextBox x:Name="TxtMontoOperacion"
                                     Height="35"
                                     Margin="0,5,0,0"/>
                            <TextBlock Text="Selecciona primero un colchón en la tabla inferior."
                                       Margin="0,8,0,0"
                                       Foreground="#6B7280"
                                       FontSize="12"/>
                        </StackPanel>

                        <Button Grid.Column="2"
                                Content="Depositar"
                                Width="100"
                                Height="35"
                                VerticalAlignment="Bottom"
                                Click="BtnDepositar_Click"/>

                        <Button Grid.Column="4"
                                Content="Retirar"
                                Width="100"
                                Height="35"
                                VerticalAlignment="Bottom"
                                Click="BtnRetirar_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="8"
                Padding="12"
                MinHeight="340">

            <DataGrid x:Name="DgColchones"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      GridLinesVisibility="All"
                      AlternatingRowBackground="#F8FAFC"
                      RowBackground="White"
                      ColumnHeaderHeight="34"
                      RowHeight="30"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding Id}"
                                        Width="60"/>

                    <DataGridTextColumn Header="Usuario"
                                        Binding="{Binding UsuarioId}"
                                        Width="90"/>

                    <DataGridTextColumn Header="Monto actual"
                                        Binding="{Binding MontoActual}"
                                        Width="160"/>

                    <DataGridTextColumn Header="Monto meta"
                                        Binding="{Binding Meta}"
                                        Width="160"/>

                    <DataGridTextColumn Header="% Ahorro"
                                        Binding="{Binding PorcentajeAhorro}"
                                        Width="110"/>

                    <DataGridTextColumn Header="Estado"
                                        Binding="{Binding Estado}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Fecha creacion"
                                        Binding="{Binding FechaCreacion}"
                                        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Button Grid.Row="3"
                Content="Volver"
                Width="110"
                Height="35"
                HorizontalAlignment="Right"
                Margin="0,12,0,0"
                Click="BtnVolver_Click"/>
    </Grid>
</Window>
